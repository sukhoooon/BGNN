{
  "profile": "independent_sampling",
  "property": "mp",
  "n_runs": 30,
  "seed_start": 1,
  "architecture": {
    "num_layers": 5,
    "hidden_channels": 128,
    "fingerprint_channels": 64
  },
  "gnn_dropout": 0.3,
  "bgnn_dropout": 0.3,
  "split": {
    "test_fraction": 0.2,
    "validation_fraction": 0.1,
    "train_fraction": 1
  },
  "fit": {
    "n_epoch": 500,
    "n_batch": null,
    "n_rand": 100,
    "lr": 0.001,
    "lr_scheduling": true,
    "min_lr": 0.000001,
    "patience": 10,
    "factor": 0.8,
    "resume": false,
    "scale_loss": 1,
    "scale_kl": 1,
    "scale_prior": 1,
    "z_regularize_opt": null,
    "scaling": true,
    "no_decay": false,
    "loss_thres_rel": 0.001,
    "error_thres_rel": 0.001,
    "loss_patience": 60,
    "loss_tolerance": 0.0,
    "clipping": true,
    "gradient_bounds": [
      -10,
      10
    ],
    "warmstart": true,
    "etype": "mae",
    "metric_per_epoch": true
  }
}
